{
  "name": "oscar-provider-mcp",
  "version": "1.0.0",
  "description": "An MCP server for searching an Oscar Health in-network provider directory (doctors and facilities).",
  "main": "dist/server.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "setup": "node scripts/setup.mjs"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
