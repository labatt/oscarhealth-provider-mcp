# Public origin of this server. This is the OAuth issuer, so it must match
# exactly and must NOT have a trailing slash.
MCP_PUBLIC_URL=https://mcp.example.com

# Loopback port. nginx (or another reverse proxy) terminates TLS in front.
MCP_PORT=3070

# Operator login for the OAuth consent flow.
MCP_LOGIN_USER=operator
MCP_LOGIN_PASSWORD_HASH=replace_with_an_argon2id_hash

# Optional. Defaults to https://www.hioscar.com. Leave this line commented out
# unless you are pointing at something else — a key present but EMPTY is an
# empty string, not "unset", and would blank the base URL.
# OSCAR_BASE_URL=https://www.hioscar.com

# REQUIRED. Comma-separated hostnames allowed as OAuth redirect targets.
#
# This fails CLOSED: left blank, no client can be authorized at all. That is
# deliberate. Dynamic client registration is open, so otherwise anyone who finds
# your URL could register a client named after something you trust, point it at
# their own callback, and send you an /authorize link — you would see a real
# consent page on your own domain and type your real password.
#
# Connect your client once, read the hostname off the refusal page, put it here
# and restart. For Claude that is:
#   MCP_ALLOWED_REDIRECT_HOSTS=claude.ai
# Use * to allow any host, only if you have understood the above.
MCP_ALLOWED_REDIRECT_HOSTS=
